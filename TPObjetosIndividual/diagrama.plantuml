@startuml
class Entradas{
    banda
    fecha
    precioBase
    --
    precioFinal()
}
object productora {
    bandas
    asistentes
    impuesto
    --
    agregarBanda()
    agregarAsistente()
    gananciaTotal()
    entradasVendidas()
    entradasVendidasTotal()
    bandaMasPopular()
    entradasVendidasDe(banda)
    bonificarVIP()
}
abstract Banda{
    nombre
    canon
    --
    presupuesto()
    popularidad()

}
class BandaRock extends Banda{
    solosGitarra
    presupuesto()
    popularidad()
}
class BandaTrap extends Banda{
    hielo
    presupuesto()
    popularidad()
}
class BandaIndie extends Banda{
    cantidadInstrumentos
    --
    popularidad()
    presupuesto()
}
class Asistente{
    abono
    anioActual
    historialEntradas
    saldo
    gastoTotal
    descuento
    --
    precioDescontado(entrada)
    comprarEntrada(entrada)
    entradasAnioAnterior()
    nombreBandasVistas()
}
interface Abono  {
    porcentajeDescuento()
    bonificar()
}

object abonoFan {
    --
    porcentajeDescuento()
    bonificar()
}

class AbonoVip {
    porcentajeDescuento
    --
    porcentajeDescuento()
    bonificar()
}
productora --> "*" Asistente
productora --> "*" Banda
Asistente --> "*" Entradas
Asistente --> Abono
abonoFan .u.|> Abono
AbonoVip .u.|> Abono
@enduml
